# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# 브라우저 다운로드 중인 임시 파일
*.crdownload

# 무기 연출 GIF (수십 MB) — 저장소에 올리지 않음
src/images/무기/*.gif

# 캐릭터 원본 일러스트 (약 100MB) — 변환본(public/operators)만 저장소에 올림
src/images/캐릭터/
